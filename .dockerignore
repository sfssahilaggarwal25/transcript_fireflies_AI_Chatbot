# ── Python runtime artifacts ──────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/

# ── Secrets (set these as env vars in Railway dashboard instead) ──────────────
.env
.env.local
.env.*.local

# ── Test folders (not needed at runtime) ─────────────────────────────────────
app/agent/tests/
app/rag/tests/
app/tests/

# ── Planning & architecture docs inside app/ (not needed at runtime) ─────────
app/agent/ARCHITECTURE.md
app/agent/PLAN.md

# ── Root-level docs and dev scripts ──────────────────────────────────────────
docs/
scripts/

# ── Dev artifacts / large output files ───────────────────────────────────────
pipeline.log
*.log
test_output.txt
chunks_output.json
uv.lock

# ── DeepEval cache ────────────────────────────────────────────────────────────
.deepeval/

# ── Git history ───────────────────────────────────────────────────────────────
.git/
.gitignore

# ── IDE and OS files ──────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# NOTE: chroma_db/ is intentionally NOT listed here.
# It holds the pre-built vector index (34 MB) required at runtime.
